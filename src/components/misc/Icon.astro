---
import { iconMap } from "./iconify-data";

interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
const data = iconMap[name];
---

{data && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox={`0 0 ${data.width} ${data.height}`}
    width="1em"
    height="1em"
    class={className}
    set:html={data.body}
  />
)}
